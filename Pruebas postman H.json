    {
      "name": "HU-002 / CA-1.2.1 - Registrar palabra en el deck",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 - tarjeta creada', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('La tarjeta nace en estado pendiente_revision', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.estado || (jsonData.tarjeta && jsonData.tarjeta.estado)).to.eql('pendiente_revision');",
              "});",
              "",
              "pm.test('resultado indica que fue creada (CA-1.3.4)', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.resultado).to.eql('creada');",
              "});"
            ],
