          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test('estado -> rechazada', function () {",
              "    pm.expect(j.resultado).to.eql('rechazada');",
              "    pm.expect(j.tarjeta.estado).to.eql('rechazada');",
              "});",
              "pm.test('la observacion QUEDO GUARDADA en tarjeta.motivo_rechazo', function () {",
              "    pm.expect(j.tarjeta.motivo_rechazo).to.eql('La definicion mezcla dos acepciones; separa el uso ritual del botanico.');",
              "});",
              "pm.test('se genero notificacion para el estudiante aportante', function () {",
              "    pm.expect(j.notificacion).to.be.an('object');",
              "    pm.expect(j.notificacion.tipo).to.eql('tarjeta_rechazada');",
              "    pm.expect(j.notificacion.leida).to.eql(false);",
              "});",
              "if (j.notificacion) { pm.collectionVariables.set('aportante_id', j.notificacion.usuario_id); }"
            ]
          }
        }
