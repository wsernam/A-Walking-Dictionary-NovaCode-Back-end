        {
          "name": "CA-3.1.1 / CA-3.1.2 / CA-3.1.3 - Generar quiz acumulativo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 - quiz generado', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Se genero una pregunta por cada tarjeta aprobada (CA-3.1.1)', function () {",
                  "    pm.expect(jsonData.preguntas.length).to.eql(4);",
                  "});",
                  "",
                  "pm.test('El quiz nace en estado \"programado\" en base de datos (CA-3.1.3)', function () {",
                  "    pm.expect(jsonData.quiz.estado).to.eql('programado');",
                  "});",
                  "",
                  "pm.test('estado_efectivo es \"abierto\" porque fecha_apertura ya paso (CA-3.1.3)', function () {",
                  "    pm.expect(jsonData.quiz.estado_efectivo).to.eql('abierto');",
                  "});",
                  "",
                  "pm.test('Cada pregunta tiene 4 opciones sin repetir, incluyendo la respuesta correcta (CA-3.1.2)', function () {",
                  "    jsonData.preguntas.forEach(function (p) {",
                  "        const opciones = [p.opcion_a, p.opcion_b, p.opcion_c, p.opcion_d];",
                  "        const unicas = new Set(opciones);",
                  "        pm.expect(unicas.size).to.eql(opciones.length);",
                  "        pm.expect(opciones).to.include(p.respuesta_correcta);",
                  "    });",
                  "});",
                  "",
                  "if (jsonData.quiz && jsonData.quiz.id_quiz) {",
                  "    pm.collectionVariables.set('he3_quiz_id', jsonData.quiz.id_quiz);",
                  "    pm.collectionVariables.set('he3_preguntas_json', JSON.stringify(jsonData.preguntas));",
                  "}"
                ],
                "type": "text/javascript"
