          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Arma el body de submit contestando TODO correcto, a partir de las preguntas",
                  "// que dejo guardadas la peticion 'Generar quiz acumulativo' (he3_preguntas_json).",
                  "// Asi la prueba no depende de conocer de antemano el orden aleatorio de las opciones.",
                  "const preguntas = JSON.parse(pm.collectionVariables.get('he3_preguntas_json') || '[]');",
                  "const respuestas = preguntas.map(function (p) {",
                  "    return { pregunta_id: p.id_pregunta, respuesta_estudiante: p.respuesta_correcta };",
                  "});",
                  "const body = { estudiante_id: 2, tiempo_empleado_seg: 300, respuestas: respuestas };",
                  "pm.collectionVariables.set('he3_submit_body_correcto', JSON.stringify(body));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 - respuestas registradas', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Calificacion perfecta al responder todo correcto (CA-3.2.2)', function () {",
                  "    pm.expect(Number(jsonData.resultado.calificacion)).to.eql(5);",
                  "});",
                  "",
                  "pm.test('puntaje_obtenido es igual a puntaje_maximo', function () {",
                  "    pm.expect(Number(jsonData.resultado.puntaje_obtenido)).to.eql(Number(jsonData.resultado.puntaje_maximo));",
                  "});",
                  "",
                  "pm.test('Se registro una respuesta por cada pregunta del quiz', function () {",
                  "    pm.expect(jsonData.respuestas.length).to.eql(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
