# Copiar este archivo como .env y completar con los valores reales.
# Nunca commitear el archivo .env con credenciales reales.

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=walking_dictionary

# Autenticación
# JWT_SECRET: usado para FIRMAR el token propio de la app (el que se manda en cada request
# despues del login). No confundir con GOOGLE_CLIENT_ID.
JWT_SECRET=change-me

# GOOGLE_CLIENT_ID: "Client ID" de un OAuth 2.0 Client (tipo "Web application") creado en
# Google Cloud Console (console.cloud.google.com > APIs & Services > Credentials). Se usa para
# verificar que el idToken que manda el frontend fue emitido por Google para ESTA app y no para
# otra. Es publico (no es secreto), pero cada equipo/proyecto tiene que crear el suyo -- no se
# puede inventar, hay que generarlo desde una cuenta de Google real.
GOOGLE_CLIENT_ID=reemplazar-con-tu-client-id.apps.googleusercontent.com

# SOLO DESARROLLO LOCAL: con DISABLE_AUTH=true se desactivan authenticate/requireRole (no piden
# token) para poder probar otros endpoints sin tener que loguearte primero. DISABLE_AUTH_ROL
# define el rol simulado (default "docente"). Dejar en false/comentado siempre, salvo cuando
# estés probando a mano. NUNCA activar en producción.
DISABLE_AUTH=false
DISABLE_AUTH_ROL=docente

# Servidor
PORT=5000
